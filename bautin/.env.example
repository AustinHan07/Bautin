# Bautin per-profile secrets (~/.hermes/profiles/<lane>/.env, chmod 600, never committed).
OPENAI_API_KEY=            # main loop + side tasks
# ANTHROPIC_API_KEY=       # optional fallback provider
FIRECRAWL_API_KEY=         # web search + extraction
TELEGRAM_BOT_TOKEN=        # the profile that owns the bot
TELEGRAM_ALLOWED_USERS=    # your numeric Telegram user id (deny-all otherwise)
# HERMES_LANGFUSE_PUBLIC_KEY=
# HERMES_LANGFUSE_SECRET_KEY=
# HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# HERMES_LANGFUSE_ENV=<lane>
